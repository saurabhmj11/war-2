# LegalLens environment variables
# Copy this file to `.env` and fill in the values.
# Never commit your real .env file.

# Prisma SQLite database location
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# Optional: Z.ai SDK configuration (for LLM + VLM calls)
# The SDK auto-discovers .z-ai-config in project root, home dir, or /etc/.
# If you're running outside the Z.ai sandbox, create a .z-ai-config with:
# {
#   "baseUrl": "https://your-api-endpoint/v1",
#   "apiKey": "your-api-key"
# }
